FROM alpine:3.21

# Install vsftpd and necessary packages
RUN apk update && apk upgrade && \
    apk add --no-cache \
        vsftpd \
        openssl \
        shadow \
        bash

# Create FTP user and group
RUN addgroup -g 1001 ftpgroup && \
    adduser -D -s /bin/bash -u 1001 -G ftpgroup ftpuser

# Create necessary directories
RUN mkdir -p /var/ftp/wordpress \
    /var/log/vsftpd \
    /etc/vsftpd \
    /var/run/vsftpd/empty

# Set up WordPress directory permissions
RUN chown -R ftpuser:ftpgroup /var/ftp/wordpress && \
    chmod 755 /var/ftp/wordpress

# Copy vsftpd configuration
COPY conf/vsftpd.conf /etc/vsftpd/vsftpd.conf

# Copy startup script
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Create log file
RUN touch /var/log/vsftpd/vsftpd.log && \
    chown ftpuser:ftpgroup /var/log/vsftpd/vsftpd.log

# Expose FTP ports
# Port 21 for control connection
# Ports 21000-21010 for passive data connections
EXPOSE 21 21000-21010

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD netstat -ln | grep :21 || exit 1

# Start FTP server
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["vsftpd", "/etc/vsftpd/vsftpd.conf"]
