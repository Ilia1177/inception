#!/bin/sh

# Define default values of Environment Variables
FTP_USER=$FTP_USER
FTP_PASS=$FTP_PASS

# Add the FTP_USER, change his password and declare him as the owner of his home folder and all subfolders
addgroup -g 1000 -S $FTP_USER
adduser -u 1000 -D -G $FTP_USER -h /home/$FTP_USER/ftp -s /bin/false  $FTP_USER
echo "$FTP_USER:$FTP_PASS" | /usr/sbin/chpasswd
chown -R $FTP_USER:$FTP_USER /home/$FTP_USER/

# Give FTP user write access to WordPress directory
chown -R $FTP_USER:$FTP_USER /var/www/wordpress
chmod -R 775 /var/www/wordpress
# Ensure wp-content is writable for uploads
chmod -R 777 /var/www/wordpress/wp-content


# Run the vsftpd server avec config personnalisée
echo "Running vsftpd with custom config"
/usr/sbin/vsftpd /etc/vsftpd/vsftpd.conf

